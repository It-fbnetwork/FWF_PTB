# --- Vercel / apps/web ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=fwf-photobooth
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
OPERATOR_PIN=1234
AGENT_TOKEN=change-me-long-random-token
DISPLAY_DURATION_MS=8000
DISPLAY_FADE_MS=700

# --- apps/agent (store Mac) ---
FWF_API_URL=https://fwf-ptb-delta.vercel.app
FWF_AGENT_TOKEN=change-me-long-random-token
FWF_WATCH_DIR=/Users/YOUR_USER/Pictures
FWF_DATA_DIR=/Users/YOUR_USER/FWF_PhotoBooth
FWF_OUTPUT_WIDTH=960
FWF_OUTPUT_HEIGHT=1280
FWF_JPEG_QUALITY=90
