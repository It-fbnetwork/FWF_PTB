{
  "name": "@fwf/agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --outDir dist --noEmit false",
    "start": "npm run build && node --env-file=../web/.env.local dist/index.js",
    "dev": "node --env-file=../web/.env.local --import tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
